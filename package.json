{
  "name": "teaboom-card",
  "private": true,
  "version": "1.0.0",
  "description": "Адаптивная карточка товара для интернет-магазина Teaboom.ru.",
  "author": {
    "name": "Igor Bocharov",
    "url": "https://github.com/i-bocharov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/i-bocharov/teaboom-card.git"
  },
  "homepage": "https://github.com/i-bocharov/teaboom-card",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "build": "tsc && vite build",
    "lint": "eslint .",
